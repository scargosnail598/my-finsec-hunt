.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.finsec-secrets/
workspaces/.finsec-secrets/

# Workspaces are researcher data. Existing tracked examples remain tracked, but new roots stay local.
workspaces/*
!workspaces/.gitkeep

# Precision benchmark reports are generated; compact labels/goldens live under tests/fixtures.
benchmark-results/
workflow-precision-report.json
workflow-precision-report.md

# Keep potentially sensitive captures and raw evidence out of Git.
captures/
!finsec/captures/
*.har
!examples/business-logic-demo.har
!tests/fixtures/session_capture/*.har
workspaces/*/observations/raw/*
workspaces/*/observations/har/*
workspaces/*/observations/screenshots/*
workspaces/*/evidence/**/requests/*
workspaces/*/evidence/**/responses/*
workspaces/*/evidence/**/screenshots/*
workspaces/*/evidence/**/attachments/*
workspaces/*/evidence/**/before.json
workspaces/*/evidence/**/after.json
