{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finsec-hunt.local/schemas/endpoint.schema.json",
  "title": "FinSec Hunt Endpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "method", "path", "hosts", "channels", "authentication", "classification", "resource", "action", "parameters", "state_change", "financial_impact", "security_relevance", "disposition", "observed_by", "sources", "confidence", "knowledge_status", "normalization"],
  "properties": {
    "id": {"type": "string", "pattern": "^EP-[0-9]+$"},
    "method": {"type": "string"},
    "path": {"type": "string", "pattern": "^/"},
    "hosts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "channels": {"type": "array", "items": {"enum": ["WEB", "MOBILE", "PARTNER_API", "PUBLIC_API", "UNKNOWN"]}},
    "authentication": {"type": "object"},
    "classification": {"type": "object"},
    "resource": {"type": "object"},
    "action": {"type": "object"},
    "parameters": {"type": "array", "items": {"type": "object"}},
    "object_access": {"type": "array", "items": {"type": "object"}},
    "ownership_inference": {"type": "array", "items": {"type": "object"}},
    "state_change": {"type": "boolean"},
    "state_change_confidence": {"enum": ["OBSERVED", "INFERRED", "ASSUMED", "CONFIRMED", "REFUTED"]},
    "state_change_reasons": {"type": "array", "items": {"type": "string"}},
    "side_effect_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "action", "references", "reason", "confidence"],
        "properties": {
          "kind": {
            "enum": [
              "CORRELATED_STATE_DELTA",
              "TRUSTED_CONTRACT_ANNOTATION",
              "HIGH_CONFIDENCE_SIGNAL"
            ]
          },
          "action": {"type": "string", "minLength": 1},
          "references": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "financial_impact": {"enum": ["none", "unknown"]},
    "security_relevance": {"type": "integer", "minimum": 0, "maximum": 10},
    "relevance_reasons": {"type": "array", "items": {"type": "string"}},
    "disposition": {
      "enum": ["ACTIVE", "SUPPRESSED_STATIC_ASSET", "SUPPRESSED_TELEMETRY", "SUPPRESSED_ANALYTICS", "SUPPRESSED_THIRD_PARTY", "SUPPRESSED_PUBLIC_RESOURCE", "SUPPRESSED_INSUFFICIENT_EVIDENCE"]
    },
    "observed_by": {"type": "array", "items": {"type": "string"}},
    "baseline_observed_by": {"type": "array", "items": {"type": "string"}},
    "capture_modes": {
      "type": "array",
      "items": {
        "enum": ["NORMAL_BEHAVIOR", "RESEARCHER_PROBE", "AUTHENTICATION", "MIXED", "UNKNOWN"]
      }
    },
    "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "confidence": {"enum": ["low", "medium", "high"]},
    "knowledge_status": {"const": "INFERRED"},
    "normalization": {"type": "object"}
  }
}
