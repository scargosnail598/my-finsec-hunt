{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finsec-hunt.local/schemas/target.schema.json",
  "title": "FinSec Hunt Target",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "scope", "accounts", "testing", "restrictions", "focus"],
  "properties": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "slug": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "type": {"type": "string"},
        "base_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {"hosts": {"type": "array", "items": {"type": "string"}}}
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownership"],
        "properties": {
          "id": {"type": "string"},
          "ownership": {"enum": ["researcher", "external"]},
          "role": {"type": "string"},
          "authenticated": {"type": "boolean"},
          "actor_type": {
            "type": ["string", "null"],
            "enum": ["authenticated_user", "privileged_user", "anonymous", "other", null]
          },
          "authentication": {
            "oneOf": [
              {"$ref": "actor-authentication.schema.json"},
              {"type": "null"}
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verification_level": {"type": "string"},
              "channel": {"enum": ["web", "mobile", "api", "unknown"]},
              "tier": {"type": ["string", "null"]},
              "merchant_customer_role": {"type": ["string", "null"]},
              "notes": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "human_approval_required", "destructive_testing"],
      "properties": {
        "production": {"type": "boolean"},
        "synthetic": {"type": "boolean"},
        "local_lab": {"type": "boolean"},
        "human_approval_required": {"type": "boolean"},
        "destructive_testing": {"type": "boolean"},
        "active_execution_enabled": {"type": "boolean"},
        "maximum_parallel_requests": {"type": "integer", "minimum": 1},
        "maximum_requests_per_plan": {"type": "integer", "minimum": 1, "maximum": 10},
        "read_only_only": {"type": "boolean"},
        "maximum_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760
        },
        "connection_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "read_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "authentication_expiring_soon_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "authentication_execution_margin_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        }
      }
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denial_of_service", "brute_force", "social_engineering", "spam", "destructive_actions"],
      "properties": {
        "denial_of_service": {"type": "boolean"},
        "brute_force": {"type": "boolean"},
        "social_engineering": {"type": "boolean"},
        "spam": {"type": "boolean"},
        "destructive_actions": {"type": "boolean"},
        "real_user_testing": {"type": "boolean"}
      }
    },
    "focus": {
      "type": "array",
      "items": {
        "enum": [
          "authorization",
          "authentication",
          "business_logic",
          "financial_workflows",
          "state_transitions",
          "replay_and_idempotency",
          "api_version_differences",
          "channel_differences"
        ]
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_hosts": {"type": "array", "items": {"type": "string"}},
        "exclude_hosts": {"type": "array", "items": {"type": "string"}},
        "suppress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "static_assets": {"type": "boolean"},
            "telemetry": {"type": "boolean"},
            "analytics": {"type": "boolean"},
            "third_party": {"type": "boolean"}
          }
        },
        "excluded_extensions": {"type": "array", "items": {"type": "string"}},
        "excluded_path_patterns": {"type": "array", "items": {"type": "string"}},
        "hypothesis_gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bola_minimum_score": {"type": "integer", "minimum": 0, "maximum": 10},
            "state_transition_minimum_score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "financial_minimum_score": {"type": "integer", "minimum": 0, "maximum": 10}
          }
        },
        "ownership_inference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trusted_parent_parameters": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "public_shared_parameters": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            }
          }
        },
        "function_authorization_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "resource", "allowed_roles", "rationale"],
            "properties": {
              "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
              "path": {"type": "string", "pattern": "^/[^?#]*$"},
              "resource": {"type": "string", "minLength": 1},
              "allowed_roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        },
        "jwt_algorithm_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "path",
              "token_location",
              "token_parameter",
              "rejected_algorithms",
              "rationale"
            ],
            "properties": {
              "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
              "path": {"type": "string", "pattern": "^/[^?#]*$"},
              "token_location": {"enum": ["header", "cookie", "body", "query"]},
              "token_parameter": {"type": "string", "minLength": 1},
              "rejected_algorithms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        },
        "endpoint_side_effect_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "action", "rationale", "evidence_refs"],
            "properties": {
              "method": {"enum": ["GET", "HEAD", "OPTIONS"]},
              "path": {"type": "string", "pattern": "^/[^?#]*$"},
              "action": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1},
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "domain_intent_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "visibility", "rationale", "evidence_refs"],
            "properties": {
              "method": {
                "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"]
              },
              "path": {"type": "string", "pattern": "^/[^?#]*$"},
              "subject_resource": {"type": ["string", "null"], "minLength": 1},
              "parent_resource": {"type": ["string", "null"], "minLength": 1},
              "operation": {
                "type": ["string", "null"],
                "enum": [
                  "READ",
                  "CREATE",
                  "CREATE_CHILD",
                  "UPDATE",
                  "DELETE",
                  "TRANSITION",
                  "VERIFY_CREDENTIAL",
                  "ACTION",
                  "UNKNOWN",
                  null
                ]
              },
              "visibility": {
                "enum": [
                  "PUBLIC",
                  "SHARED",
                  "OWNER_SCOPED",
                  "ROLE_SCOPED",
                  "ACTOR_BOUND",
                  "UNKNOWN"
                ]
              },
              "binding": {
                "enum": [
                  "OWNERSHIP",
                  "INITIATING_ACTOR",
                  "PRODUCER_CONSUMER",
                  "SESSION",
                  "ROLE",
                  "TENANT_ACCOUNT",
                  "UNKNOWN"
                ]
              },
              "rationale": {"type": "string", "minLength": 1},
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "classification_overrides": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "FIRST_PARTY_API",
              "STATIC_ASSET",
              "TELEMETRY",
              "ANALYTICS",
              "THIRD_PARTY",
              "PAGE_NAVIGATION",
              "FILE_DOWNLOAD",
              "AUTHENTICATION",
              "FINANCIAL",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  }
}
