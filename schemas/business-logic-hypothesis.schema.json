{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finsec-hunt.local/schemas/business-logic-hypothesis.schema.json",
  "title": "FinSec Hunt Business Logic Hypothesis Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hypotheses"],
  "properties": {
    "version": {"enum": [1, 2, 3]},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fingerprint",
          "title",
          "family",
          "workflow_family_id",
          "invariant_id",
          "canonical_behavior",
          "mutated_behavior",
          "score",
          "safety_classification",
          "readiness_blockers",
          "kind",
          "epistemic_status"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^BLH-[A-F0-9]{16}$"},
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "title": {"type": "string", "minLength": 1},
          "family": {
            "enum": [
              "STEP_SKIPPING",
              "OUT_OF_ORDER_EXECUTION",
              "REPLAY",
              "DUPLICATE_ACTION",
              "CONCURRENT_EXECUTION",
              "TERMINAL_STATE_BYPASS",
              "ACTOR_SWITCH",
              "RESOURCE_SWITCH",
              "CROSS_WORKFLOW_TOKEN_REUSE",
              "PARTIAL_ROLLBACK",
              "QUANTITY_VALUE_INVARIANT",
              "ROLE_APPROVAL_BYPASS",
              "SHADOW_ENDPOINT"
            ]
          },
          "workflow_family_id": {"type": "string"},
          "invariant_id": {"type": "string"},
          "canonical_behavior": {"type": "string"},
          "mutated_behavior": {"type": "string"},
          "score": {"type": "object"},
          "safety_classification": {"type": "string"},
          "readiness_blockers": {"type": "array", "items": {"type": "string"}},
          "candidate_methods": {"type": "array", "items": {"type": "string"}},
          "candidate_paths": {"type": "array", "items": {"type": "string"}},
          "candidate_fields": {"type": "array", "items": {"type": "string"}},
          "kind": {"enum": ["SECURITY_HYPOTHESIS", "RESEARCH_TASK"]},
          "readiness": {"enum": ["RESEARCH_ONLY", "REVIEW_REQUIRED", "TEST_READY"]},
          "epistemic_status": {
            "enum": [
              "RESEARCH_TASK",
              "TEST_CANDIDATE",
              "TEST_PLANNED",
              "NEEDS_EVIDENCE",
              "REJECTED_BY_BACKEND",
              "CONFIRMED"
            ]
          }
        }
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "workflow_family_id",
          "mutation_family",
          "affected_action",
          "reasons",
          "evidence"
        ]
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "semantic_fingerprint",
          "semantics",
          "title",
          "representative_hypothesis_id",
          "member_hypothesis_ids",
          "support_contexts",
          "independent_supports",
          "context_count",
          "independent_support_count",
          "highest_score",
          "research_score",
          "hypothesis_confidence",
          "evidence_strength",
          "promotion",
          "readiness"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^HCL-[A-F0-9]{16}$"},
          "semantic_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "semantics": {
            "type": "object",
            "required": [
              "vulnerability_family",
              "subject_action",
              "subject_resource",
              "violated_property",
              "mutation_type",
              "fingerprint",
              "canonical_id"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "representative_hypothesis_id": {
            "type": "string",
            "pattern": "^BLH-[A-F0-9]{16}$"
          },
          "member_hypothesis_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^BLH-[A-F0-9]{16}$"}
          },
          "support_contexts": {"type": "array", "items": {"type": "object"}},
          "independent_supports": {"type": "array", "items": {"type": "object"}},
          "context_count": {"type": "integer", "minimum": 1},
          "independent_support_count": {"type": "integer", "minimum": 0},
          "highest_score": {"type": "integer", "minimum": 4, "maximum": 20},
          "research_score": {"type": "integer", "minimum": 0},
          "hypothesis_confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "evidence_strength": {
            "enum": ["STRONG", "MODERATE", "WEAK", "INSUFFICIENT"]
          },
          "promotion": {
            "enum": [
              "SUPPRESSED",
              "RESEARCH_LOW",
              "RESEARCH_MEDIUM",
              "RESEARCH_HIGH",
              "REVIEW_REQUIRED",
              "TEST_READY"
            ]
          },
          "readiness": {"enum": ["RESEARCH_ONLY", "REVIEW_REQUIRED", "TEST_READY"]}
        }
      }
    }
  }
}
