{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finsec-hunt.local/schemas/hypothesis.schema.json",
  "title": "FinSec Hunt Hypothesis (Phase 3 Contract)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "key",
    "title",
    "kind",
    "disposition",
    "category",
    "component",
    "source",
    "mutation_dimensions",
    "evidence_status",
    "hypothesis",
    "reasoning",
    "preconditions",
    "expected_secure_behavior",
    "possible_vulnerable_behavior",
    "potential_impact",
    "evidence_to_collect",
    "eligibility_evidence",
    "missing_evidence",
    "generation_rule",
    "scores",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?:HYP-[0-9]+|BLH-[A-F0-9]{16})$"
    },
    "key": {"type": "string"},
    "title": {"type": "string"},
    "kind": {"enum": ["SECURITY_HYPOTHESIS", "RESEARCH_TASK"]},
    "disposition": {
      "enum": ["ACTIVE", "SUPPRESSED_STATIC_ASSET", "SUPPRESSED_TELEMETRY", "SUPPRESSED_THIRD_PARTY", "SUPPRESSED_PUBLIC_RESOURCE", "SUPPRESSED_INSUFFICIENT_EVIDENCE", "SUPPRESSED_DUPLICATE", "NEEDS_RESEARCH"]
    },
    "category": {
      "enum": [
        "authentication",
        "authorization",
        "state_integrity",
        "replay",
        "value_validation",
        "version_parity",
        "channel_parity",
        "research",
        "business_logic"
      ]
    },
    "component": {"type": "string"},
    "source": {"$ref": "#/$defs/hypothesisSource"},
    "invariant": {
      "type": "array",
      "items": {"type": "string"}
    },
    "observations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "mutation_dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "ACTOR",
          "OBJECT",
          "STATE",
          "TIME",
          "VALUE",
          "CHANNEL",
          "VERSION",
          "WORKFLOW",
          "CONCURRENCY"
        ]
      },
      "minItems": 0
    },
    "required_state": {
      "type": "array",
      "items": {"type": "string"}
    },
    "attacker_capability": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_status": {"$ref": "#/$defs/knowledgeStatus"},
    "hypothesis": {"type": "string"},
    "reasoning": {"type": "string"},
    "preconditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "expected_secure_behavior": {"type": "string"},
    "possible_vulnerable_behavior": {"type": "string"},
    "potential_impact": {"$ref": "#/$defs/potentialImpact"},
    "evidence_to_collect": {
      "type": "array",
      "items": {"type": "string"}
    },
    "eligibility_evidence": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "generation_rule": {"type": "object", "additionalProperties": {"type": "string"}},
    "priority_rationale": {"type": "array", "items": {"type": "string"}},
    "scores": {"$ref": "#/$defs/hypothesisScores"},
    "priority": {"enum": ["P1", "P2", "P3"]},
    "status": {
      "default": "NOT_TESTED",
      "enum": [
        "NOT_TESTED",
        "TEST_PLANNED",
        "REFUTED",
        "NEEDS_EVIDENCE",
        "CONFIRMED"
      ]
    },
    "safety_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "readiness": {"enum": ["RESEARCH_ONLY", "REVIEW_REQUIRED", "TEST_READY"]},
    "readiness_assessment": {"$ref": "#/$defs/readinessAssessment"},
    "domain_intent": {"$ref": "#/$defs/domainIntent"},
    "claim_strength": {"$ref": "#/$defs/claimStrength"},
    "semantic_descriptor": {
      "anyOf": [{"$ref": "#/$defs/semanticDescriptor"}, {"type": "null"}]
    },
    "grouping": {"$ref": "#/$defs/hypothesisGrouping"},
    "presentation": {"$ref": "#/$defs/hypothesisPresentation"},
    "epistemic_status": {"type": ["string", "null"]},
    "logic_details": {"type": ["object", "null"]},
    "notes": {
      "type": ["string", "null"]
    },
    "generation": {
      "anyOf": [
        {"$ref": "#/$defs/generationMetadata"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "hypothesisSource": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "invariants": {
          "type": "array",
          "items": {"type": "string"}
        },
        "observations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "hypothesisScores": {
      "type": "object",
      "additionalProperties": true,
      "required": ["impact", "likelihood", "confidence", "testability", "total"],
      "properties": {
        "impact": {"type": "integer", "minimum": 1, "maximum": 5},
        "likelihood": {"type": "integer", "minimum": 1, "maximum": 5},
        "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "testability": {"type": "integer", "minimum": 1, "maximum": 5},
        "total": {"type": "integer", "minimum": 4, "maximum": 20}
      }
    },
    "impactLevel": {
      "enum": ["none", "low", "medium", "high", "unknown"]
    },
    "potentialImpact": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "confidentiality": {"$ref": "#/$defs/impactLevel"},
        "integrity": {"$ref": "#/$defs/impactLevel"},
        "availability": {"$ref": "#/$defs/impactLevel"},
        "financial": {"$ref": "#/$defs/impactLevel"}
      }
    },
    "knowledgeStatus": {
      "enum": ["OBSERVED", "INFERRED", "ASSUMED", "CONFIRMED", "REFUTED"]
    },
    "generationMetadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generator", "generated_checksum", "source_fingerprint"],
      "properties": {
        "managed": {"type": "boolean", "default": true},
        "generator": {"type": "string"},
        "generated_checksum": {"type": "string"},
        "source_fingerprint": {"type": "string"}
      }
    },
    "decisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "source", "detail"],
      "properties": {
        "reference": {"type": "string"},
        "source": {
          "enum": [
            "OBSERVATION",
            "ENDPOINT",
            "INVARIANT",
            "WORKFLOW",
            "TARGET_POLICY",
            "GENERATOR",
            "LEGACY"
          ]
        },
        "detail": {"type": "string"}
      }
    },
    "domainIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_resource",
        "operation",
        "visibility",
        "binding",
        "positive_evidence",
        "counterevidence",
        "ambiguity",
        "confidence"
      ],
      "properties": {
        "subject_resource": {"type": "string"},
        "parent_resource": {"type": ["string", "null"]},
        "operation": {
          "enum": [
            "READ",
            "CREATE",
            "CREATE_CHILD",
            "UPDATE",
            "DELETE",
            "TRANSITION",
            "VERIFY_CREDENTIAL",
            "ACTION",
            "UNKNOWN"
          ]
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "SHARED",
            "OWNER_SCOPED",
            "ROLE_SCOPED",
            "ACTOR_BOUND",
            "UNKNOWN"
          ]
        },
        "binding": {
          "enum": [
            "OWNERSHIP",
            "INITIATING_ACTOR",
            "PRODUCER_CONSUMER",
            "SESSION",
            "ROLE",
            "TENANT_ACCOUNT",
            "UNKNOWN"
          ]
        },
        "positive_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/decisionEvidence"}
        },
        "counterevidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/decisionEvidence"}
        },
        "ambiguity": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]}
      }
    },
    "claimStrength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_level",
        "target_level",
        "evidence",
        "upgrade_requirements",
        "explanation"
      ],
      "properties": {
        "current_level": {"pattern": "^[1-5]_"},
        "target_level": {"pattern": "^[1-5]_"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/decisionEvidence"}},
        "upgrade_requirements": {"type": "array", "items": {"type": "string"}},
        "explanation": {"type": "string"}
      }
    },
    "readinessIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "summary", "evidence"],
      "properties": {
        "code": {"type": "string"},
        "stage": {
          "enum": [
            "HYPOTHESIS_EVIDENCE",
            "PLAN_CONSTRUCTABILITY",
            "HUMAN_APPROVAL",
            "EXECUTION_POLICY"
          ]
        },
        "capability": {"type": ["string", "null"]},
        "summary": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/decisionEvidence"}},
        "next_action": {"type": ["string", "null"]}
      }
    },
    "readinessAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "evaluator",
        "readiness",
        "actionable_plan",
        "reasons",
        "missing_prerequisites",
        "blockers",
        "warnings",
        "capabilities",
        "evidence_references"
      ],
      "properties": {
        "version": {"const": 1},
        "evaluator": {"type": "string"},
        "readiness": {"enum": ["RESEARCH_ONLY", "REVIEW_REQUIRED", "TEST_READY"]},
        "actionable_plan": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "missing_prerequisites": {"type": "array", "items": {"type": "string"}},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/readinessIssue"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/readinessIssue"}},
        "capabilities": {"type": "array", "items": {"type": "object"}},
        "evidence_references": {"type": "array", "items": {"type": "string"}}
      }
    },
    "semanticDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_key", "campaign_key", "operation", "weakness_family"],
      "properties": {
        "target_services": {"type": "array", "items": {"type": "string"}},
        "route_families": {"type": "array", "items": {"type": "string"}},
        "methods": {"type": "array", "items": {"type": "string"}},
        "operation": {"type": "string"},
        "subject_resource": {"type": "string"},
        "parent_resource": {"type": ["string", "null"]},
        "visibility": {"type": "string"},
        "binding": {"type": "string"},
        "weakness_family": {"type": "string"},
        "test_operator": {"type": "string"},
        "expected_effect": {"type": "string"},
        "oracle_family": {"type": "string"},
        "actor_requirements": {"type": "array", "items": {"type": "string"}},
        "workflow_family": {"type": ["string", "null"]},
        "transition": {"type": ["string", "null"]},
        "exact_key": {"type": "string"},
        "campaign_key": {"type": "string"}
      }
    },
    "hypothesisGrouping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "campaign_id": {"type": ["string", "null"]},
        "cluster_id": {"type": ["string", "null"]},
        "relationship": {
          "enum": ["EXACT_DUPLICATE", "OVERLAPPING_TEST_CAMPAIGN", "RELATED_DISTINCT", "NONE"]
        },
        "primary_hypothesis_id": {"type": ["string", "null"]},
        "cluster_member_ids": {"type": "array", "items": {"type": "string"}},
        "campaign_member_ids": {"type": "array", "items": {"type": "string"}},
        "member_generators": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hypothesisPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {"type": "boolean"},
        "display_title": {"type": ["string", "null"]},
        "suppression_reason": {"type": ["string", "null"]},
        "next_action": {"type": ["string", "null"]}
      }
    }
  }
}
