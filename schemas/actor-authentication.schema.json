{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finsec-hunt.local/schemas/actor-authentication.schema.json",
  "title": "FinSec Hunt Actor Authentication",
  "type": "object",
  "additionalProperties": false,
  "required": ["auth_type", "source", "expiration", "refresh", "identity", "status"],
  "properties": {
    "auth_type": {"type": "string"},
    "profile_ref": {"type": ["string", "null"]},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "location", "credential_ref", "purpose", "replay_required"],
        "properties": {
          "name": {"type": "string"},
          "location": {"enum": ["header", "cookie", "body"]},
          "credential_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
          "purpose": {"enum": ["access", "session", "api_key", "csrf", "refresh", "other"]},
          "replay_required": {"type": "boolean"},
          "value_prefix": {"type": "string"},
          "cookie_domain": {"type": ["string", "null"]},
          "cookie_path": {"type": ["string", "null"]},
          "cookie_session_only": {"type": ["boolean", "null"]}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["har", "burp_xml", "raw_request", "manual", "legacy_environment", "none"]
        },
        "file_reference": {"type": ["string", "null"]},
        "captured_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "expiration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detectable": {"type": "boolean"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "issued_at": {"type": ["string", "null"], "format": "date-time"},
        "not_before": {"type": ["string", "null"], "format": "date-time"},
        "last_checked_at": {"type": ["string", "null"], "format": "date-time"},
        "source": {"enum": ["jwt", "cookie", "target", "unknown"]}
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configured": {"type": "boolean"},
        "flow_ref": {"type": ["string", "null"]},
        "request_template_ref": {"type": ["string", "null"]},
        "mode": {"type": ["string", "null"], "enum": ["observed_request", null]},
        "method": {"type": ["string", "null"]},
        "scheme": {"type": ["string", "null"]},
        "host": {"type": ["string", "null"]},
        "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "path": {"type": ["string", "null"]},
        "response_access_path": {"type": ["string", "null"]},
        "response_refresh_path": {"type": ["string", "null"]},
        "expected_status": {"type": ["integer", "null"]},
        "expected_content_type": {"type": ["string", "null"]},
        "request_budget": {"type": "integer", "const": 1},
        "auto_refresh": {"type": "boolean"}
      }
    },
    "baseline": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "method": {"enum": ["GET", "HEAD"]},
        "scheme": {"enum": ["http", "https"]},
        "host": {"type": "string"},
        "port": {"type": ["integer", "null"]},
        "path": {"type": "string"},
        "query_parameters": {"type": "object"},
        "safe_headers": {"type": "object"},
        "expected_status": {"type": ["integer", "null"]},
        "expected_content_type": {"type": ["string", "null"]},
        "identity_assertion": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["source", "selector"],
          "properties": {
            "source": {"enum": ["JSON_BODY", "RESPONSE_HEADER"]},
            "selector": {"type": "string", "minLength": 1},
            "expected_value": {"type": ["string", "integer", "number", "boolean", "null"]},
            "expected_actor_reference": {
              "type": ["string", "null"],
              "enum": ["account.id", "identity.subject", "identity.tenant", null]
            },
            "expected_status": {
              "type": ["integer", "null"],
              "minimum": 200,
              "maximum": 299
            },
            "redaction": {"enum": ["OMIT", "SHA256"]}
          },
          "oneOf": [
            {"required": ["expected_value"]},
            {"required": ["expected_actor_reference"]}
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {"type": ["string", "null"]},
        "roles": {"type": "array", "items": {"type": "string"}},
        "tenant": {"type": ["string", "null"]},
        "baseline_identifier_fingerprint": {"type": ["string", "null"]},
        "confirmed": {"type": "boolean"},
        "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
        "confirmation_reference": {"type": ["string", "null"]},
        "last_assertion_status": {
          "enum": [
            "NOT_CONFIGURED",
            "NOT_CHECKED",
            "CONFIRMED",
            "STATUS_MISMATCH",
            "LOGIN_OR_ERROR_RESPONSE",
            "MALFORMED_BODY",
            "SELECTOR_MISSING",
            "SELECTOR_AMBIGUOUS",
            "EXPECTED_VALUE_MISSING",
            "VALUE_MISMATCH",
            "LEGACY_UNTRUSTED"
          ]
        },
        "baseline_confirmed": {"type": "boolean", "deprecated": true}
      }
    },
    "status": {
      "enum": [
        "READY",
        "EXPIRING_SOON",
        "EXPIRED",
        "INVALID",
        "MISSING",
        "AVAILABLE_NOT_VALIDATED",
        "REFRESH_REQUIRED",
        "REFRESH_FAILED",
        "AUTH_CONTEXT_CHANGED",
        "NONE"
      ]
    },
    "context_fingerprint": {"type": ["string", "null"]},
    "target_hosts": {"type": "array", "items": {"type": "string"}},
    "credential_accepted": {"type": "boolean"},
    "credential_accepted_at": {"type": ["string", "null"], "format": "date-time"},
    "scope_validated": {"type": "boolean"},
    "scope_validated_at": {"type": ["string", "null"], "format": "date-time"},
    "last_validated_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "deprecated": true
    },
    "legacy_environment": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
